# Copy to .env and fill in. Never commit .env (see .gitignore).
# Deployer / oracle wallet private key, hex WITH 0x prefix (testnet-only wallet; needs Base Sepolia ETH)
PRIVATE_KEY=
# JSON-RPC endpoint for Base Sepolia, e.g. https://sepolia.base.org or an Alchemy/Infura URL
RPC_URL=
# Google Cloud project ID registered for Earth Engine (non-commercial), used by oracle/01_export_gee.py
# OAuth token itself lives outside the repo (~/.config/earthengine/credentials) via `earthengine authenticate`
GEE_PROJECT=
# Optional, demo only (scripts/seed-demo.mjs): extra testnet wallets that play a rogue exporter and two ordinary ones
ROGUE_PRIVATE_KEY=
EXPORTER_A_PRIVATE_KEY=
EXPORTER_B_PRIVATE_KEY=
