# Optional overrides for the frontend (Vite exposes VITE_* only). Defaults live in src/config.ts.
# JSON-RPC used for reads and simulations (wallet transactions go through the connected wallet).
VITE_RPC_URL=https://sepolia.base.org
# Where scripts/sync-zk.mjs fetches the proving key when circuits/build/ is absent (e.g. on Vercel).
ZKEY_URL=
